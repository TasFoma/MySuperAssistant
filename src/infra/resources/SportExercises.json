      "kind": "Exercise",
      "data": {
        "identifier": "sport-03",
        "revision": "2026-11-24-v1",
        "title": "Приседание без отягощения",
        "aliases": [],
        "muscles": [
          "Бёдра",
          "Ягодичные",
          "Корпус"
        ],
        "equipment": [],
        "errors": [
          "Отрыв пяток: проверьте амплитуду.",
          "Колени заваливаются внутрь: контролируйте направление.",
          "Потеря положения спины: не углубляйте движение за предел контроля."
        ],
        "limitations": [
          "Нужны устойчивое положение стоя и свободное пространство. Амплитуда индивидуальна и фиксируется при изменении."
        ],
        "alternatives": [
          "sport-01",
          "sport-02",
          "sport-04",
          "sport-05"
        ],
        "technique": {
          "brief": "Устойчивые стопы, таз назад и вниз, колени по направлению стоп; контролируемый возврат.",
          "preparation": "Встаньте, расположив стопы чуть шире таза. Носки немного наружу, плечи опущены, корпус собран.",
          "steps": [
            "Начните опускание движением таза назад, затем сгибайте колени.",
            "Сохраняйте устойчивые стопы и положение спины. Колени следуют направлению носков.",
            "Закончите опускание до потери контроля: отрыва пяток или выраженного округления корпуса.",
            "Вернитесь в стойку, разгибая ноги и сохраняя опору всей стопой."
          ],
          "breathing": "На подъёме выдыхайте; движение остаётся контролируемым.",
          "counting": "Один полный цикл движения и возврата — одно повторение. Обе стороны работают одновременно."
        },
        "requirements": {
          "palmSupport": false,
