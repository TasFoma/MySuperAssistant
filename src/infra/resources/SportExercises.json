        "revision": "2026-11-24-v1",
        "title": "Отжимание с колен",
        "aliases": [],
        "muscles": [
          "Грудь",
          "Плечи",
          "Руки"
        ],
        "equipment": [],
        "errors": [
          "Таз остаётся поднятым: восстановите линию корпуса.",
          "Провисание поясницы.",
          "Движение только головой вместо корпуса."
        ],
        "limitations": [
          "Требуются выход на пол, опора на ладони и колени. Вариант не объединяется с обычными отжиманиями в одну серию прогресса."
        ],
        "alternatives": [
          "sport-09",
          "sport-10",
          "sport-12"
        ],
        "technique": {
          "brief": "Опора на ладони и колени; корпус от головы до колен движется одной линией.",
          "preparation": "Опуститесь на колени, поставьте ладони примерно на ширине плеч. Перенесите корпус вперёд, плечи над кистями.",
          "steps": [
            "Выстройте корпус от головы до колен и соберите мышцы живота.",
            "Сгибая руки, медленно опускайте корпус, не поднимая таз и не проваливая поясницу.",
            "Удерживайте голову в продолжении спины; локти рядом с корпусом или немного в стороны.",
            "Оттолкнитесь ладонями и вернитесь к исходному положению."
          ],
          "breathing": "Отдельная схема дыхания в первоисточнике не задана.",
          "counting": "Один полный цикл движения и возврата — одно повторение. Обе стороны работают одновременно."
        },
